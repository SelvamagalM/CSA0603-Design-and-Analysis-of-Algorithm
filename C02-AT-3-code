def selection_sort(arr):
    """Sorts a list in ascending order using an optimized Selection Sort."""
    n = len(arr)
    for i in range(n - 1):              # FIXED: correct outer loop range
        min_idx = i
        for j in range(i + 1, n):       # find index of the minimum element
            if arr[j] < arr[min_idx]:
                min_idx = j
        if min_idx != i:                # OPTIMIZATION: skip unnecessary swap
            arr[i], arr[min_idx] = arr[min_idx], arr[i]
    return arr


# Example usage
if __name__ == "__main__":
    arr = [29, 10, 14, 37, 13]
    print("Sorted array:", selection_sort(arr))
